# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# Database (Render Postgres URL looks like postgresql://user:pass@host/db)
SQLITE_DATABASE_URI=sqlite:///coolgym.db

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Cloudinary (profile picture uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed frontend origins (Netlify URL, local dev)
FRONTEND_ORIGINS=https://your-app.netlify.app,http://localhost:5173

# Google Identity Services (web OAuth client ID only; never put a client secret in the frontend)
GOOGLE_CLIENT_ID=

# Optional: JSON list of WebRTC ICE/TURN servers
WEBRTC_ICE_SERVERS=

# SMTP email replies for Contact Messages
# Use ssl/465 for most providers, or starttls/587 when required.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CoolGym <no-reply@example.com>
